---
const courses = [
  { grade: '6 класс', title: 'Числа обретают смысл', description: 'Делимость, дроби, отношения, отрицательные числа, формулы, координаты, наглядная геометрия и данные.', href: '/6-klass/', ready: true, status: '7 глав готовы' },
  { grade: '7 класс', title: 'Появляется язык алгебры', description: 'Степени, многочлены, линейные модели, первые доказательства и случайные опыты.', href: '/7-klass/', ready: true, status: '5 глав готовы' },
  { grade: '8 класс', title: 'Связи становятся глубже', description: 'Корни, алгебраические дроби, квадратные уравнения, неравенства, подобие и деревья вероятностей.', href: '/8-klass/', ready: true, status: '6 глав готовы' },
  { grade: '9 класс', title: 'Методы работают вместе', description: 'Системы, парабола, прогрессии, решение треугольников, векторы и комбинаторика.', href: '/9-klass/', ready: true, status: '6 глав готовы' },
  { grade: '10 класс', title: 'Функции и пространство', description: 'Язык функций, тригонометрия, логика, стереометрия, многогранники и условная вероятность.', href: '/10-klass/', ready: true, status: '6 глав готовы' },
  { grade: '11 класс', title: 'Изменение и накопление', description: 'Логарифмы, производная, интеграл, объёмы и статистика.', href: '/11-klass/' },
];
---

<div class="dm-course-grid not-content">
  {courses.map((course) => (
    <a class="dm-course-card" href={course.href}>
      <span class="dm-course-card__grade">{course.grade}</span>
      <h3>{course.title}</h3>
      <p>{course.description}</p>
      <span class:list={['dm-course-card__status', course.ready && 'dm-course-card__status--ready']}>
        {course.ready ? course.status : 'в плане'}
      </span>
    </a>
  ))}
</div>
