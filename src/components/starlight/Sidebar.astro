---
/**
 * Боковое меню, показывающее только текущий курс.
 *
 * Книга и курс Lean независимы, поэтому в меню видно ровно одно из двух —
 * то, где читатель сейчас находится. Переключение живёт в шапке, а на
 * узких экранах дублируется здесь же, наверху меню.
 *
 * Разметку дефолтного компонента не копируем: берём его составные части,
 * подменив только список разделов.
 */
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import CourseSwitcher from '../CourseSwitcher.astro';
import { withBase } from '../../lib/basePath';

const { sidebar } = Astro.locals.starlightRoute;

const leanPrefix = withBase('/lean');

/** Раздел относится к курсу Lean, если хоть одна ссылка внутри ведёт в /lean/. */
function belongsToLean(entry: (typeof sidebar)[number]): boolean {
  if (entry.type === 'link') return entry.href.startsWith(leanPrefix);
  return entry.entries.some(belongsToLean);
}

const isLeanRoute = Astro.url.pathname.startsWith(leanPrefix);
const visible = sidebar.filter((entry) => belongsToLean(entry) === isLeanRoute);
---

<CourseSwitcher class="dm-course-switcher--sidebar" />

<SidebarPersister>
  <SidebarSublist sublist={visible} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  /* В шапке переключатель уже есть, поэтому на широких экранах прячем копию. */
  .dm-course-switcher--sidebar {
    margin-bottom: 1rem;
  }

  @media (min-width: 50rem) {
    .dm-course-switcher--sidebar {
      display: none;
    }
  }
</style>
