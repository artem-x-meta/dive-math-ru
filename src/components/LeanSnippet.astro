---
/**
 * Кусок настоящего Lean-файла из каталога lean/.
 *
 * Код не дублируется в разметке: компонент читает его из файла на сборке.
 * Значит, в курсе не может оказаться примера, который не компилируется —
 * эти же файлы проверяет `lake build` в CI.
 *
 * Границы куска размечаются комментариями в самом .lean-файле:
 *
 *   -- НАЧАЛО: first-proof
 *   theorem my_first : 2 + 2 = 4 := rfl
 *   -- КОНЕЦ: first-proof
 *
 * Маркеры в сниппет не попадают.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** Путь внутри каталога lean/, например 'DiveLean/Ch01/Basics.lean'. */
  file: string;
  /** Имя размеченного куска. Без него берётся весь файл, кроме импортов. */
  region?: string;
  /** Подпись над кодом. */
  title?: string;
  /** Показывать кнопку «открыть в песочнице». */
  playground?: boolean;
}

const { file, region, title, playground = true } = Astro.props;

const source = readFileSync(join(process.cwd(), 'lean', file), 'utf8');

function extractRegion(text: string, name: string): string {
  const lines = text.split(/\r?\n/);
  const start = lines.findIndex((line) => line.trim() === `-- НАЧАЛО: ${name}`);
  const end = lines.findIndex((line) => line.trim() === `-- КОНЕЦ: ${name}`);
  if (start === -1 || end === -1 || end < start) {
    throw new Error(`LeanSnippet: в файле lean/${file} не найден кусок «${name}»`);
  }
  return lines.slice(start + 1, end).join('\n').replace(/\s+$/, '');
}

const code = region ? extractRegion(source, region) : source.trim();

// Песочнице нужны импорты: внутри куска их обычно нет, берём из шапки файла.
const imports = source
  .split(/\r?\n/)
  .filter((line) => line.startsWith('import '))
  .join('\n');

const playgroundCode = imports && !code.startsWith('import') ? `${imports}\n\n${code}` : code;
const playgroundUrl = `https://live.lean-lang.org/#code=${encodeURIComponent(playgroundCode)}`;
---

<figure class="dm-lean-snippet not-content">
  {title && <figcaption class="dm-lean-snippet__title">{title}</figcaption>}
  <pre class="dm-lean-snippet__code"><code>{code}</code></pre>
  {playground && (
    <a class="dm-lean-snippet__playground" href={playgroundUrl} target="_blank" rel="noopener">
      Открыть в песочнице <span aria-hidden="true">↗</span>
    </a>
  )}
</figure>
