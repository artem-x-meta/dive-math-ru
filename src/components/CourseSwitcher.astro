---
/**
 * Переключатель между двумя независимыми курсами сайта.
 *
 * Книга 6–11 классов и курс Lean связаны только темой, поэтому держать
 * их в одном дереве навигации неудобно: сайдбар становится длинным, а
 * читателю показывают то, что ему сейчас не нужно. Переключатель решает,
 * какой из двух курсов виден.
 */
import { withBase } from '../lib/basePath';

interface Props {
  /** Дополнительный класс — используется, чтобы прятать копию на узких экранах. */
  class?: string;
}

const base = withBase('/lean');
const isLean = Astro.url.pathname.startsWith(base);

const courses = [
  { label: 'Книга 6–11', href: withBase('/'), active: !isLean },
  { label: 'Lean', href: withBase('/lean/'), active: isLean },
];
---

<nav class:list={['dm-course-switcher', Astro.props.class]} aria-label="Выбор курса">
  {
    courses.map((course) => (
      <a href={course.href} aria-current={course.active ? 'page' : undefined}>
        {course.label}
      </a>
    ))
  }
</nav>

<style>
  .dm-course-switcher {
    display: flex;
    gap: 0.15rem;
    padding: 0.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-black);
    white-space: nowrap;
  }

  .dm-course-switcher a {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }

  .dm-course-switcher a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  /* Текущий курс подсвечен и не ведёт никуда полезного — это указатель. */
  .dm-course-switcher a[aria-current='page'] {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-text-accent);
  }
</style>
